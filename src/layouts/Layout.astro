---
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import BaseHead from '@/components/BaseHead.astro';
import { getLocalizedPath, locales, type Locale } from '@/i18n';

interface Props {
	title?: string;
	description?: string;
	width?: 'wide' | 'reading';
	locale?: Locale;
	path?: string;
	localizedPaths?: Partial<Record<Locale, string>>;
}

const { title = 'Codguides', description, width = 'wide', locale = 'ru', path = '', localizedPaths } = Astro.props;
const languagePaths = localizedPaths ?? Object.fromEntries(locales.map((item) => [item, getLocalizedPath(item, path)])) as Partial<Record<Locale, string>>;
---

<!doctype html>
<html lang={locale}>
	<head>
		<BaseHead {title} {description} localizedPaths={languagePaths} />
	</head>
	<body>
		<Header {locale} {path} localizedPaths={languagePaths} />
		<main class:list={['site-container', { 'reading-width': width === 'reading' }]}>
			<slot />
		</main>
		<Footer {locale} />
	</body>
</html>

<style is:global>
	:root {
		--page-gutter: 1.25rem;
		--page-width: 100%;
		--reading-width: 48rem;
		--page-spacing: clamp(2rem, 5vw, 4rem);
	}
	*, *::before, *::after { box-sizing: border-box; }
	html {
		margin: 0;
		min-height: 100%;
		font-family: system-ui, sans-serif;
		color: #202124;
	}
	body {
		margin: 0;
		min-height: 100vh;
		min-height: 100dvh;
		display: flex;
		flex-direction: column;
	}
	.site-container {
		width: 100%;
		max-width: var(--page-width);
		margin-inline: auto;
		padding-inline: var(--page-gutter);
		min-width: 0;
	}
	main.site-container {
		flex: 1;
		padding-block: var(--page-spacing);
		overflow-wrap: anywhere;
	}
	main.reading-width {
		max-width: calc(var(--reading-width) + 2 * var(--page-gutter));
	}
</style>
