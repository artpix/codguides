---
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import { getLocalizedPath, locales, type Locale } from '../i18n';

interface Props {
	title?: string;
	locale?: Locale;
	path?: string;
}

const { title = 'Codguides', locale = 'ru', path = '' } = Astro.props;
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		{
			locales.map((item) => (
				<link rel="alternate" hreflang={item} href={getLocalizedPath(item, path)} />
			))
		}
		<link rel="alternate" hreflang="x-default" href={getLocalizedPath('ru', path)} />
	</head>
	<body>
		<LanguageSwitcher locale={locale} path={path} />
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
