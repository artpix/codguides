---
import LanguageSwitcher from '@/components/LanguageSwitcher.astro';
import { getLocalizedPath, locales, type Locale } from '@/i18n';

interface Props {
	title?: string;
	locale?: Locale;
	path?: string;
	localizedPaths?: Partial<Record<Locale, string>>;
}

const { title = 'Codguides', locale = 'ru', path = '', localizedPaths } = Astro.props;
const languagePaths = localizedPaths ?? Object.fromEntries(locales.map((item) => [item, getLocalizedPath(item, path)])) as Partial<Record<Locale, string>>;
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		{
			locales.filter((item) => languagePaths[item]).map((item) => (
				<link rel="alternate" hreflang={item} href={languagePaths[item]} />
			))
		}
		{languagePaths.ru && <link rel="alternate" hreflang="x-default" href={languagePaths.ru} />}
	</head>
	<body>
		<LanguageSwitcher locale={locale} path={path} localizedPaths={languagePaths} />
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
