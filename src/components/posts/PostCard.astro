---
import type { LocalizedPost } from '@/types/pocketbase';
import { createPocketBase } from '@/lib/pocketbase/client';
import type { Locale } from '@/i18n';
import { getPostPath } from '@/lib/paths';
import PostTags from '@/components/posts/PostTags.astro';

interface Props {
	post: LocalizedPost;
	locale: Locale;
}

const { post, locale } = Astro.props;
const { translation } = post;
const source = post.expand?.source;
const ogImage = post.expand?.og_image;
const sourceLabel = source?.title ?? source?.name ?? source?.url;
const imageUrl = ogImage?.file
	? createPocketBase().files.getURL(ogImage, ogImage.file)
	: undefined;
---

<article class="post-card">
	<PostTags tags={post.expand?.tags} {locale} />
	<h2><a href={getPostPath(locale, translation.slug)}>{translation.title}</a></h2>
	<p>{translation.seo_description}</p>
	{source?.url && <a href={source.url}>{sourceLabel}</a>}
	{imageUrl && <img src={imageUrl} alt={ogImage?.alt || translation.title} width="100" height="100" />}
</article>

<style>
	.post-card {
		padding: 1.25rem;
		border: 1px solid #d9dce3;
		background: #fff;
	}

	h2 {
		margin: 0 0 0.75rem;
		font-size: 1.25rem;
	}

	p {
		margin: 0;
		line-height: 1.6;
		white-space: pre-wrap;
	}
</style>
