---
import type { Post } from '../../types/pocketbase';

interface Props {
	post: Post;
}

const { post } = Astro.props;
---

<article class="post-card">
	<h2>{post.title}</h2>
	<p>{post.content}</p>
</article>

<style>
	.post-card {
		padding: 1.25rem;
		border: 1px solid #d9dce3;
		border-radius: 0.75rem;
		background: #fff;
	}

	h2 {
		margin: 0 0 0.75rem;
		font-size: 1.25rem;
	}

	p {
		margin: 0;
		line-height: 1.6;
		white-space: pre-wrap;
	}
</style>
