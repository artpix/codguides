---
import type { Post } from '../../types/pocketbase';
import { createPocketBase } from '../../lib/pocketbase/client';

interface Props {
	post: Post;
}

const { post } = Astro.props;
const source = post.expand?.source;
const ogImage = post.expand?.og_image;
const sourceLabel = source?.title ?? source?.name ?? source?.url;
const imageUrl = ogImage?.file
	? createPocketBase().files.getURL(ogImage, ogImage.file)
	: undefined;
---

<article class="post-card">
	<h2>{post.title}</h2>
	<p>{post.description}</p>
	{source?.url && <a href={source.url}>{sourceLabel}</a>}
	{imageUrl && <img src={imageUrl} alt={ogImage?.alt ?? post.title} width="100" height="100" />}
</article>

<style>
	.post-card {
		padding: 1.25rem;
		border: 1px solid #d9dce3;
		background: #fff;
	}

	h2 {
		margin: 0 0 0.75rem;
		font-size: 1.25rem;
	}

	p {
		margin: 0;
		line-height: 1.6;
		white-space: pre-wrap;
	}
</style>
