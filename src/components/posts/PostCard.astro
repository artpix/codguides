---
import type { LocalizedPost } from '@/types/pocketbase';
import { createPocketBase } from '@/lib/pocketbase/client';
import type { Locale } from '@/i18n';
import { getPostPath } from '@/lib/paths';
import PostTags from '@/components/posts/PostTags.astro';

interface Props {
	post: LocalizedPost;
	locale: Locale;
}

const { post, locale } = Astro.props;
const { translation } = post;
const source = post.expand?.source;
const ogImage = post.expand?.og_image;
const sourceLabel = source?.title ?? source?.name ?? source?.url;
const imageUrl = ogImage?.file
	? createPocketBase().files.getURL(ogImage, ogImage.file)
	: undefined;
const postPath = getPostPath(locale, translation.slug);
const publishedDate = new Date(post.date_created);
const hasDate = !Number.isNaN(publishedDate.getTime());
const dateLabel = hasDate
	? new Intl.DateTimeFormat(locale, { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(publishedDate)
	: undefined;
---

<article class="post-card">
	{imageUrl && (
		<a class="cover-link" href={postPath} tabindex="-1" aria-hidden="true">
			<img src={imageUrl} alt="" width="640" height="360" loading="lazy" decoding="async" />
		</a>
	)}
	<div class="post-body">
		<PostTags tags={post.expand?.tags} {locale} />
		<h2><a href={postPath}>{translation.title}</a></h2>
		{translation.seo_description && <p class="description">{translation.seo_description}</p>}
		{(hasDate || source?.url) && (
			<div class="meta">
				{hasDate && <time datetime={publishedDate.toISOString()}>{dateLabel}</time>}
				{source?.url && <a href={source.url}>{sourceLabel}</a>}
			</div>
		)}
	</div>
</article>

<style>
	.post-card {
		display: flex;
		flex-direction: column;
		width: 100%;
		min-width: 0;
		border: 1px solid #d9dce3;
		background: #fff;
		overflow-wrap: anywhere;
	}

	.post-body {
		display: flex;
		flex-direction: column;
		flex: 1;
		min-width: 0;
		padding: 1.25rem;
	}
	.cover-link { display: block; }
	img {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 16 / 9;
		object-fit: cover;
		background: #f3f4f5;
	}

	h2 {
		margin: 0.5rem 0 0;
		font-size: clamp(1.25rem, 2.5vw, 1.5rem);
		line-height: 1.35;
	}

	.description {
		margin: 0.75rem 0 0;
		line-height: 1.6;
		white-space: pre-wrap;
	}

	a { color: inherit; text-underline-offset: 0.2em; }
	h2 a { text-decoration: none; }
	h2 a:hover { text-decoration: underline; }
	a:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
	.meta { display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; margin-top: auto; padding-top: 1rem; color: #555b63; font-size: 0.875rem; line-height: 1.5; }
</style>
