---
import { ArrowRight } from '@lucide/astro';
import type { Locale } from '@/i18n';
import type { LocalizedPost } from '@/types/pocketbase';
import { getPostPath } from '@/lib/paths';
import { createPocketBase } from '@/lib/pocketbase/client';

interface Props {
	post: LocalizedPost;
	locale: Locale;
	featured?: boolean;
}

const { post, locale, featured = false } = Astro.props;
const { translation } = post;
const image = post.expand?.og_image;
const imageUrl = image?.file ? createPocketBase().files.getURL(image, image.file) : undefined;
const date = new Date(post.date_created);
const validDate = !Number.isNaN(date.getTime());
const dateLabel = validDate
	? new Intl.DateTimeFormat(locale, { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' }).format(date)
	: undefined;
---

<article class:list={['home-post', { featured }]}>
	<a class="card-link" href={getPostPath(locale, translation.slug)}>
		<div class="media">
			{imageUrl && <img src={imageUrl} alt={image?.alt || ''} loading={featured ? 'eager' : 'lazy'} />}
		</div>
		<div class="body">
			<div>
				{featured && validDate && <time datetime={date.toISOString()}>{dateLabel}</time>}
				<h3>{translation.title}</h3>
				{translation.seo_description && <p>{translation.seo_description}</p>}
			</div>
			<div class="card-footer">
				{!featured && validDate && <time datetime={date.toISOString()}>{dateLabel}</time>}
				<span class="arrow-circle"><ArrowRight size={18} aria-hidden="true" /></span>
			</div>
		</div>
	</a>
</article>

<style>

.home-post { min-width: 0; }
.card-link { display: flex; flex-direction: column; height: 100%; color: inherit; text-decoration: none; border: 1px solid #e4dfd6; border-radius: 6px; overflow: hidden; background: #fffcf7; transition: border-color 180ms ease, box-shadow 180ms ease; }
.card-link:hover { border-color: #d7b28d; box-shadow: 0 5px 18px #1118200a; }
.media { position: relative; aspect-ratio: 2.7; background: #e0e2e5; overflow: hidden; }
.media img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform 200ms ease; }
.card-link:hover img { transform: scale(1.025); }
.body { display: flex; flex: 1; flex-direction: column; gap: 0.7rem; padding: 0.85rem; }
.body > div { min-width: 0; }
.body > div:first-child { flex: 1; }
h3 { margin: 0 0 0.45rem; font-size: 1rem; line-height: 1.4; }
p { margin: 0; line-height: 1.4; color: #72736f; font-size: 0.85rem; }
.home-post:not(.featured) h3,
.home-post:not(.featured) p {
	display: -webkit-box;
	-webkit-box-orient: vertical;
	-webkit-line-clamp: 2;
	line-clamp: 2;
	overflow: hidden;
}
.card-footer { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; width: 100%; }
time { color: #85867e; font-size: 0.7rem; }
.arrow-circle { display: grid; place-items: center; flex-shrink: 0; width: 28px; height: 28px; margin-inline-start: auto; color: #c95713; border-radius: 4px; background: #f5e8da; }
.card-link:hover .arrow-circle { background: #e87c2d; color: #fff; }
.featured { grid-row: span 2; }
.featured .card-link { position: relative; min-height: 23rem; overflow: hidden; border-radius: 6px; border: 0; box-shadow: none; background: #111820; }
.featured .media { position: absolute; inset: 0; aspect-ratio: auto; border-radius: 0; background: transparent; }
.featured .media img { height: 100%; object-fit: cover; object-position: 90% center; }
.featured .card-link:hover img { transform: none; }
.featured .body { position: relative; flex: none; flex-direction: row; align-items: flex-end; margin-top: auto; padding: 5rem 1.5rem 1.5rem; color: #fff; background: linear-gradient(to top, #0b1016f5 0%, #0b1016d9 48%, #0b101680 75%, transparent 100%); }
.featured .card-footer { width: auto; }
.featured h3 { margin-top: 0.6rem; font-size: clamp(1.5rem, 2.1vw, 2rem); line-height: 1.35; }
.featured p, .featured time { color: #f1eee5; }
.featured .arrow-circle { width: 46px; height: 46px; background: #ed812c; color: white; border-color: #ed812c; align-self: flex-end; }
.card-link:focus-visible { outline: 2px solid #d36b23; outline-offset: 5px; }
@media (prefers-reduced-motion: reduce) { .media img, .card-link { transition: none; } .card-link:hover img { transform: none; } }
@media (max-width: 900px) { .featured { grid-row: auto; grid-column: 1 / -1; } .featured .card-link { min-height: 22rem; } }
@media (max-width: 560px) { .featured .body { padding: 4rem 1rem 1rem; } .featured .card-link { min-height: 20rem; } }

</style>
