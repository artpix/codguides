---
import { ArrowRight } from '@lucide/astro';
import { getLocalizedPath, useTranslations, type Locale } from '@/i18n';
import type { LocalizedPost } from '@/types/pocketbase';
import HomePostCard from '@/components/posts/HomePostCard.astro';

interface Props {
	posts: LocalizedPost[];
	locale: Locale;
	loadError?: boolean;
}

const { posts, locale, loadError = false } = Astro.props;
const t = useTranslations(locale);
---

<section aria-labelledby="latest-posts-title">
	<header>
		<h2 id="latest-posts-title">{t('home.latestPosts')}</h2>
		<a href={getLocalizedPath(locale, 'posts')}>{t('home.allPosts')} <ArrowRight size={16} aria-hidden="true" /></a>
	</header>
	{loadError ? <p role="status">{t('posts.loadError')}</p> : posts.length ? (
		<div class="posts-grid">
			{posts.map((post, index) => <HomePostCard {post} {locale} featured={index === 0} />)}
		</div>
	) : <p>{t('home.noPosts')}</p>}
</section>

<style>
	header { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; margin-bottom: 1.25rem; }
	h2 { margin: 0; font-size: clamp(1.8rem, 3vw, 2.6rem); }
	header a { flex-shrink: 0; color: #c95713; text-decoration: none; display: inline-flex; align-items: center; gap: 0.75rem; }
	.posts-grid { display: grid; grid-template-columns: var(--home-columns); gap: var(--home-gap); }
	@media (max-width: 900px) { .posts-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
	@media (max-width: 560px) {
		.posts-grid { grid-template-columns: minmax(0, 1fr); }
		header { align-items: flex-start; flex-direction: column; }
	}
</style>
