---
import type { Post } from '../../types/pocketbase';
import PostCard from './PostCard.astro';

interface Props {
	posts: Post[];
	emptyText: string;
}

const { posts, emptyText } = Astro.props;
---

{
	posts.length > 0 ? (
		<div class="post-list">
			{posts.map((post) => <PostCard post={post} />)}
		</div>
	) : (
		<p class="empty">{emptyText}</p>
	)
}

<style>
	.post-list {
		display: grid;
		gap: 1rem;
	}

	.empty {
		padding: 1.25rem;
		border-radius: 0.75rem;
		background: #eef1f7;
		color: #4d5567;
	}
</style>
