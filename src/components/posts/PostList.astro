---
import type { LocalizedPost } from '@/types/pocketbase';
import PostCard from '@/components/posts/PostCard.astro';
import type { Locale } from '@/i18n';

interface Props {
	posts: LocalizedPost[];
	locale: Locale;
	emptyText: string;
}

const { posts, locale, emptyText } = Astro.props;
---

{
	posts.length > 0 ? (
		<div class="post-list">
			{posts.map((post) => <PostCard post={post} {locale} />)}
		</div>
	) : (
		<p class="empty">{emptyText}</p>
	)
}

<style>
	.post-list {
		display: grid;
		gap: 1rem;
	}

	.empty {
		padding: 1.25rem;
		border-radius: 0.75rem;
		background: #eef1f7;
		color: #4d5567;
	}
</style>
