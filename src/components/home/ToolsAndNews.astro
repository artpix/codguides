---
import { Image } from 'astro:assets';
import { ArrowRight } from '@lucide/astro';
import speedups from '@/assets/calculators/speedups.webp';
import resources from '@/assets/calculators/resources.webp';
import troops from '@/assets/calculators/troops.webp';
import { useTranslations, type Locale } from '@/i18n';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const tools = ['speedups', 'resources', 'troops'] as const;
const toolImages = { speedups, resources, troops };
---

<div class="tools-and-news">
	<section id="tools" aria-labelledby="tools-title">
		<h2 id="tools-title">{t('home.toolsTitle')}</h2>
		<div class="tools-grid">
			{tools.map((tool) => (
				<article id={`calculator-${tool}`}>
					<div class="tool-art"><Image class="tool-image" src={toolImages[tool]} alt="" width={104} widths={[104, 208]} sizes="104px" format="webp" loading="lazy" /></div>
					<div>
					<h3>{t(`home.tools.${tool}.title`)}</h3>
					<p>{t(`home.tools.${tool}.description`)}</p>
					<span class="tool-arrow" aria-hidden="true"><ArrowRight size={16} /></span>
				</div>
				</article>
			))}
		</div>
	</section>
</div>

<style>

.tools-and-news { display: grid; gap: 2.25rem; margin-top: 2.25rem; }
section { min-width: 0; scroll-margin-top: 1.5rem; }
h2 { margin: 0 0 1rem; font-size: clamp(1.6rem, 2.5vw, 2rem); }
.tools-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.75rem; }
article { scroll-margin-top: 1.5rem; display: flex; align-items: flex-start; gap: 0.5rem; min-height: 108px; padding: 0.9rem; background: linear-gradient(120deg, #f4e9da, #f5eee4); border: 1px solid #e8dccc80; border-radius: 6px; }
article > div { min-width: 0; }
article > div:last-child { flex: 1; }
.tool-arrow { display: grid; place-items: center; width: 30px; height: 30px; margin: 0.5rem 0 0 auto; border: 1px solid #e4bc9666; border-radius: 6px; color: #c95713; background: #ffffff40; }
article:nth-child(2) { background: linear-gradient(120deg, #e8ebef, #f0f1f2); border-color: #dce0e680; }
article:nth-child(3) { background: linear-gradient(120deg, #f1e5d7, #f6ede5); }
.tool-art { display: grid; place-items: center; width: 76px; height: 76px; flex: 0 0 76px; }
.tool-image { display: block; width: 76px; max-width: 100%; height: 76px; object-fit: contain; grid-area: 1 / 1; }
h3 { margin: 0 0 0.45rem; font-size: 1.1rem; line-height: 1.2; overflow-wrap: anywhere; }
p { margin: 0; line-height: 1.5; color: #73716b; font-size: 0.78rem; }
article h3, article p { display: -webkit-box; -webkit-box-orient: vertical; overflow: hidden; }
article h3 { -webkit-line-clamp: 2; line-clamp: 2; }
article p { -webkit-line-clamp: 3; line-clamp: 3; }
@media (max-width: 900px) { .tools-grid { grid-template-columns: 1fr; } }

</style>
