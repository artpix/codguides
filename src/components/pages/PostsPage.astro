---
import { ArrowLeft } from '@lucide/astro';
import PostList from '@/components/posts/PostList.astro';
import type { Locale } from '@/i18n';
import { getLocalizedPath, useTranslations } from '@/i18n';
import Layout from '@/layouts/Layout.astro';
import { getPosts } from '@/lib/pocketbase/posts';
import type { LocalizedPost } from '@/types/pocketbase';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
let posts: LocalizedPost[] = [];
let loadError = false;

try {
	posts = await getPosts(locale);
} catch (error) {
	loadError = true;
	console.warn(
		`PocketBase недоступен: ${error instanceof Error ? error.message : 'неизвестная ошибка'}`,
	);
}
---

<Layout title={t('posts.title')} locale={locale} path="posts">
	<header class="page-header">
		<a class="back-link" href={getLocalizedPath(locale)}><ArrowLeft size={16} aria-hidden="true" /> {t('posts.backHome')}</a>
		<h1>{t('posts.title')}</h1>
	</header>

	{
		loadError ? (
			<p class="error" role="status">{t('posts.loadError')}</p>
		) : (
			<PostList posts={posts} {locale} emptyText={t('posts.empty')} />
		)
	}
</Layout>

<style>
	.page-header {
		margin-bottom: 2rem;
	}

	h1 {
		margin: 1.25rem 0 0;
		font-size: clamp(2rem, 5vw, 3rem);
		line-height: 1.15;
	}

	.back-link {
		color: inherit;
		text-underline-offset: 0.2em;
		line-height: 1.5;
	}

	.back-link:focus-visible {
		outline: 2px solid currentColor;
		outline-offset: 4px;
	}

	.error {
		padding: 1.25rem;
		margin: 0;
		border: 1px solid #d9dce3;
		line-height: 1.6;
	}
</style>
