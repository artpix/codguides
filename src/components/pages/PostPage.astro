---
import Layout from '@/layouts/Layout.astro';
import { getLocalizedPath, useTranslations, type Locale } from '@/i18n';
import { createPocketBase } from '@/lib/pocketbase/client';
import type { LocalizedPost } from '@/types/pocketbase';
import { getPostLanguagePaths } from '@/lib/pocketbase/posts';

interface Props {
	post: LocalizedPost;
	locale: Locale;
}

const { post, locale } = Astro.props;
const localizedPaths = await getPostLanguagePaths(post.id);
const t = useTranslations(locale);
const { translation } = post;
const source = post.expand?.source;
const ogImage = post.expand?.og_image;
const imageUrl = ogImage?.file
	? createPocketBase().files.getURL(ogImage, ogImage.file)
	: undefined;
---

<Layout title={translation.seo_title || translation.title} locale={locale} {localizedPaths}>
	<main>
		<a href={getLocalizedPath(locale, 'posts')}>← Все записи</a>
		<article>
			<header>
				<h1>{translation.title}</h1>
				{translation.seo_description && <p>{translation.seo_description}</p>}
			</header>
			{imageUrl && <img class="cover" src={imageUrl} alt={ogImage?.alt || translation.title} />}
			{/* HTML из редактора PocketBase; доступ к редактированию должен быть у доверенных авторов. */}
			<div class="content" set:html={translation.content} />
			{source?.url && (
				<footer>Источник: <a href={source.url}>{source.name || source.url}</a></footer>
			)}
		</article>
	</main>
</Layout>

<style>
	main {
		max-width: 48rem;
		margin: 0 auto;
		padding: 3rem 1.25rem;
		overflow-wrap: anywhere;
	}

	a,
	.content :global(a) {
		color: #5145cd;
	}

	h1 {
		font-size: clamp(2rem, 5vw, 3rem);
		line-height: 1.15;
	}

	header p,
	.content {
		line-height: 1.7;
	}

	.cover,
	.content :global(img),
	.content :global(video) {
		max-width: 100%;
		height: auto;
	}

	.cover {
		display: block;
		margin: 2rem 0;
	}

	.content :global(pre) {
		overflow-x: auto;
		padding: 1rem;
		background: #eef1f7;
	}

	footer {
		margin-top: 2rem;
		padding-top: 1rem;
		border-top: 1px solid #d9dce3;
	}
</style>
