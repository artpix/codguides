---
import { Image } from 'astro:assets';
import promo from '@/assets/promo.png';
import type { Locale } from '@/i18n';
import { useTranslations } from '@/i18n';
import Layout from '@/layouts/Layout.astro';
import LatestPosts from '@/components/posts/LatestPosts.astro';
import ToolsAndNews from '@/components/home/ToolsAndNews.astro';
import { getHomePosts } from '@/lib/pocketbase/posts';
import type { LocalizedPost } from '@/types/pocketbase';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
let posts: LocalizedPost[] = [];
let loadError = false;
try {
	posts = await getHomePosts(locale);
} catch (error) {
	loadError = true;
	console.warn('Failed to load homepage posts:', error instanceof Error ? error.message : error);
}
---

<Layout title={t('site.title')} locale={locale}>
		<section slot="hero" class="hero" aria-labelledby="home-title">
			<Image class="promo-banner" src={promo} alt="" width={1400} widths={[480, 768, 1024, 1400, 2103]} sizes="100vw" format="webp" loading="eager" fetchpriority="high" />
			<div class="site-container"><div class="hero-copy">
				<h1 id="home-title">{t('home.title')}</h1>
				<p>{t('home.description').split('Call of Dragons').map((part, index) => <>{index > 0 && <strong>Call of Dragons</strong>}{part}</>)}</p>
			</div></div>
		</section>
	<div class="home-content">
		<LatestPosts {posts} {locale} {loadError} />
		<ToolsAndNews {locale} />
	</div>
</Layout>

<style>

.home-content { --home-columns: minmax(0, 2.3fr) minmax(0, 1fr) minmax(0, 1fr); --home-gap: 1.25rem; }
.hero { position: relative; isolation: isolate; min-height: 190px; padding-block: 2rem; display: flex; align-items: center; }
.promo-banner { opacity: 0.8; position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 75% 45%; z-index: -2; }
.hero::after { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, #f8f5ef 0%, #f8f5eff2 30%, #f8f5ef70 65%, #f8f5ef18 100%), linear-gradient(0deg, #f8f5ef 0%, #f8f5ef80 12%, transparent 50%); }
.hero-copy { width: 100%; }
h1 { font-size: clamp(0.6rem, 2.4vw, 2.25rem); line-height: 1.2; margin: 0 0 0.85rem; white-space: nowrap; }
.hero p { max-width: 780px; margin: 0; color: #696b69; font-size: 1.1rem; line-height: 1.6; }
@media (max-width: 640px) { .hero { min-height: 250px; } .hero::after { background: #f8f5efde; } }

</style>
