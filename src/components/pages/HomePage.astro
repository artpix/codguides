---
import type { Locale } from '@/i18n';
import { getLocalizedPath, useTranslations } from '@/i18n';
import Layout from '@/layouts/Layout.astro';
import LatestPosts from '@/components/posts/LatestPosts.astro';
import ToolsAndNews from '@/components/home/ToolsAndNews.astro';
import { getHomePosts } from '@/lib/pocketbase/posts';
import type { LocalizedPost } from '@/types/pocketbase';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
let posts: LocalizedPost[] = [];
let loadError = false;
try {
	posts = await getHomePosts(locale);
} catch (error) {
	loadError = true;
	console.warn('Failed to load homepage posts:', error instanceof Error ? error.message : error);
}
---

<Layout title={t('site.title')} locale={locale}>
	<div class="home-content">
		<h1>{t('site.title')}</h1>
		<p>{t('home.description')}</p>
		<a href={getLocalizedPath(locale, 'posts')}>{t('home.openPosts')}</a>
		<LatestPosts {posts} {locale} {loadError} />
		<ToolsAndNews {locale} />
	</div>
</Layout>

<style>
	.home-content {
		--home-columns: minmax(0, 2.3fr) minmax(0, 1fr) minmax(0, 1fr);
		--home-gap: 1.5rem;
	}
	.home-content > :global(section) { margin-top: 3rem; }

	a {
		color: #5145cd;
	}
</style>
