---
import { ChevronDown } from '@lucide/astro';
import { Image } from 'astro:assets';
import logo from '@/assets/logo.webp';
import LanguageSwitcher from '@/components/LanguageSwitcher.astro';
import { getLocalizedPath, useTranslations, type Locale } from '@/i18n';

interface Props {
	locale: Locale;
	path?: string;
	localizedPaths?: Partial<Record<Locale, string>>;
}

const { locale, path = '', localizedPaths } = Astro.props;
const t = useTranslations(locale);
---

<header>
	<div class="header-inner site-container">
		<a class="brand" href={getLocalizedPath(locale)}>
			<Image src={logo} alt={t('site.title')} width={200} widths={[200, 400]} sizes="(max-width: 480px) 175px, 200px" format="webp" loading="eager" />
		</a>
		<nav class="main-nav" aria-label={t('nav.main')}>
			<a href="https://codguides.com/heroes/">{t('home.heroesTitle')}</a>
			<details class="dropdown">
				<summary>{t('nav.guides')}<ChevronDown class="dropdown-chevron" size={16} aria-hidden="true" /></summary>
				<ul class="dropdown-panel">
					<li><a href={getLocalizedPath(locale, 'posts')}>{t('home.allPosts')}</a></li>
					<li><a href="https://codguides.com/heroes/">{t('home.heroesTitle')}</a></li>
				</ul>
			</details>
			<details class="dropdown">
				<summary>{t('nav.tools')}<ChevronDown class="dropdown-chevron" size={16} aria-hidden="true" /></summary>
				<ul class="dropdown-panel">
					{(['speedups', 'resources', 'troops'] as const).map((tool) => (
						<li><a href={`${getLocalizedPath(locale)}#calculator-${tool}`}>{t(`home.tools.${tool}.title`)}</a></li>
					))}
				</ul>
			</details>
			<a href="https://codguides.com/codes/">{t('nav.codes')}</a>
			<a href="https://codguides.com/download/">{t('nav.download')}</a>
		</nav>
		<div class="languages"><LanguageSwitcher {locale} {path} {localizedPaths} /></div>
	</div>
</header>

<style>
	header {
		color: #f3eee4;
		background: radial-gradient(ellipse at 12% 0%, #b9853426, transparent 55%), linear-gradient(115deg, #111820, #0b1016);
		box-shadow: 0 4px 20px #0b10161a;
	}
	.header-inner { padding-block: 0.75rem; display: flex; align-items: center; flex-wrap: wrap; gap: 1rem 1.25rem; }
	.brand { display: block; flex-shrink: 0; max-width: 100%; }
	.brand img { display: block; width: 200px; max-width: 100%; height: auto; }
	.main-nav { display: flex; flex-wrap: wrap; gap: 0.25rem; font-size: 0.875rem; }
	.main-nav a, summary {
		padding: 0.75rem 0.65rem;
		border-radius: 0.25rem;
		color: #d5d9df;
		font-weight: 600;
		text-decoration: none;
		border: 1px solid transparent;
	}
	.main-nav a:hover { color: #ffe1a0; background: #ffffff08; }
	.main-nav a[aria-current='page'] { color: #ffe1a0; background: #ffffff0a; }
	.dropdown { position: relative; }
	summary { display: flex; align-items: center; gap: 0.75rem; cursor: pointer; list-style: none; }
	summary::-webkit-details-marker { display: none; }
	summary:hover, .dropdown[open] summary { color: #ffe1a0; background: #ffffff08; }
	.dropdown[open] summary :global(.dropdown-chevron) { transform: rotate(180deg); }
	.dropdown-panel {
		position: absolute;
		z-index: 10;
		inset-block-start: calc(100% + 0.5rem);
		inset-inline-start: 0;
		width: max-content;
		max-width: calc(100vw - 2 * var(--page-gutter));
		list-style: none;
		margin: 0;
		padding: 0.5rem;
		background: #141c26;
		border: 1px solid #d5a44940;
		border-radius: 0.375rem;
		box-shadow: 0 16px 40px #00000040;
	}
	.dropdown-panel a { display: block; overflow-wrap: anywhere; }
	.languages { margin-inline-start: auto; }
	header a:focus-visible, summary:focus-visible { outline: 2px solid #f1c874; outline-offset: 4px; }
	@media (max-width: 1150px) {
		.header-inner { gap: 0.75rem 1rem; }
		.main-nav { order: 3; flex-basis: 100%; border-top: 1px solid #ffffff12; padding-top: 0.75rem; }
	}
	@media (max-width: 480px) {
		.brand img { width: 175px; }
		.languages { margin-inline-start: 0; }
	}
</style>

<script>
	document.addEventListener('click', (event) => {
		if (!(event.target instanceof Node)) return;
		for (const dropdown of document.querySelectorAll<HTMLDetailsElement>('.dropdown[open]')) {
			if (!dropdown.contains(event.target) || (event.target instanceof Element && event.target.closest('a'))) dropdown.open = false;
		}
	});
	document.addEventListener('keydown', (event) => {
		if (event.key !== 'Escape') return;
		for (const dropdown of document.querySelectorAll<HTMLDetailsElement>('.dropdown[open]')) {
			if (dropdown.contains(document.activeElement)) dropdown.querySelector('summary')?.focus();
			dropdown.open = false;
		}
	});
</script>
